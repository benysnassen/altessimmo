// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  phone       String
  phoneNormalized String? @unique
  email       String?
  type        ContactType
  budget      String?
  estimation  String?
  message     String?
  personalNote String? // Note personnelle de l'admin
  rating      Int?     // Évaluation de 1 à 5 étoiles
  confidential Boolean @default(false)
  status      ContactStatus @default(NEW)

  // Qualification du lead. Tous optionnels : les contacts deja en base
  // restent valides. Le pays n'est pas stocke : l'indicatif telephonique est
  // deja dans `phone`, il suffit.
  horizon     ContactHorizon?  // echeance du projet
  sourcePage  String?          // page d'entree du lead, ex "/fr/contact"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

enum ContactHorizon {
  IMMEDIATE    // sous 3 mois
  SIX_MONTHS   // 3 a 12 mois
  EXPLORING    // se renseigne
}

model Buyer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  phoneNormalized String? @unique
  email       String?
  budget      String?
  message     String?
  personalNote String? // Note personnelle de l'admin
  rating      Int?     // Évaluation de 1 à 5 étoiles
  confidential Boolean @default(false)
  status      BuyerStatus @default(NEW)
  
  // Préférences
  propertyType String? // Villa, Appartement, Terrain, etc.
  location     String? // Agdal, Hay Riad, Souissi, etc.
  minSurface   Int?    // Surface minimale en m²
  maxSurface   Int?    // Surface maximale en m²
  minRooms     Int?    // Nombre de pièces minimum
  maxRooms     Int?    // Nombre de pièces maximum
  hasGarden    Boolean @default(false)
  hasPool      Boolean @default(false)
  hasSeaView   Boolean @default(false)
  
  // Historique
  visits       Visit[]
  offers       Offer[]
  notes        Note[]
  propertyMatches PropertyMatch[]
  propertyInterests BuyerPropertyInterest[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("buyers")
}

model Seller {
  id          String   @id @default(cuid())
  name        String
  phone       String
  phoneNormalized String? @unique
  email       String?
  message     String?
  personalNote String? // Note personnelle de l'admin
  rating      Int?     // Évaluation de 1 à 5 étoiles
  confidential Boolean @default(false)
  status      SellerStatus @default(NEW)
  
  // Bien à vendre
  propertyType String? // Villa, Appartement, Terrain, etc.
  location     String? // Agdal, Hay Riad, Souissi, etc.
  surface      Int?    // Surface en m²
  rooms        Int?    // Nombre de pièces
  price        String? // Prix demandé
  hasGarden    Boolean @default(false)
  hasPool      Boolean @default(false)
  hasSeaView   Boolean @default(false)
  description  String? // Description détaillée
  
  // Historique
  visits       Visit[]
  offers       Offer[]
  notes        Note[]
  properties   Property[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sellers")
}

model Visit {
  id          String   @id @default(cuid())
  buyerId     String?
  sellerId    String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id])
  seller      Seller?  @relation(fields: [sellerId], references: [id])
  date        DateTime
  status      VisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("visits")
}

model Offer {
  id          String   @id @default(cuid())
  buyerId     String?
  sellerId    String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id])
  seller      Seller?  @relation(fields: [sellerId], references: [id])
  amount      String
  status      OfferStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("offers")
}

model Note {
  id          String   @id @default(cuid())
  buyerId     String?
  sellerId    String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id])
  seller      Seller?  @relation(fields: [sellerId], references: [id])
  content     String
  type        NoteType @default(GENERAL)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notes")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  email     String?
  lastLogin DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Property {
  id             String          @id @default(cuid())
  sellerId       String
  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title          String
  propertyType   PropertyType
  status         PropertyStatus  @default(DRAFT)
  listingType    ListingType     @default(SALE)
  location       String
  neighborhood   String?
  address        String?
  price          String
  surface        Int?
  landSurface    Int?
  rooms          Int?
  bathrooms      Int?
  garages        Int?
  floor          Int?
  yearBuilt      Int?
  description    String?
  hasGarden      Boolean         @default(false)
  hasPool        Boolean         @default(false)
  hasSeaView     Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  images         PropertyImage[]
  matches        PropertyMatch[]
  buyerInterests BuyerPropertyInterest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("properties")
}

/// Lien manuel prospect acheteur ↔ bien consulté / d'intérêt (snapshot au moment du lien).
model BuyerPropertyInterest {
  id                     String    @id @default(cuid())
  buyerId                String
  propertyId             String
  buyer                  Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  property               Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  note                   String?
  snapshotPrice          String?
  snapshotRooms          Int?
  snapshotLocation       String?
  snapshotNeighborhood   String?
  snapshotPropertyType   String?
  snapshotSurface        Int?
  createdAt              DateTime  @default(now())

  @@unique([buyerId, propertyId])
  @@map("buyer_property_interests")
}

model PropertyImage {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  isPrimary  Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@map("property_images")
}

model PropertyMatch {
  id          String    @id @default(cuid())
  propertyId  String
  buyerId     String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer       Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  score       Int
  reasons     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, buyerId])
  @@map("property_matches")
}

enum ContactType {
  BUYER
  SELLER
}

enum ContactStatus {
  NEW
  CONTACTED
  INTERESTED
  VIEWING
  OFFER
  SOLD
  ARCHIVED
}

enum BuyerStatus {
  NEW
  CONTACTED
  INTERESTED
  VIEWING
  OFFER_MADE
  NEGOTIATING
  PURCHASED
  ARCHIVED
}

enum SellerStatus {
  NEW
  CONTACTED
  EVALUATED
  LISTED
  VIEWING
  OFFER_RECEIVED
  NEGOTIATING
  SOLD
  ARCHIVED
}

enum VisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_OFFER
  EXPIRED
}

enum NoteType {
  GENERAL
  CALL
  EMAIL
  VISIT
  OFFER
  NEGOTIATION
  IMPORTANT
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  RIAD
  LAND
  COMMERCIAL
  OFFICE
  PENTHOUSE
  DUPLEX
  OTHER
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum ListingType {
  SALE
  RENT
}