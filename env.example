# Configuration de base de données PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres?sslmode=require"

# Clé secrète JWT (générez une nouvelle clé pour la production)
JWT_SECRET="your-super-secret-jwt-key-here"

# Environnement
NODE_ENV="development"

# Debug
DEBUG="true"

# Clé maître pour la création du premier admin
MASTER_KEY="your-master-key-here"
